from pyrogram import filters
from pyrogram.types import (
    Message,
    InlineKeyboardMarkup,
    InlineKeyboardButton,
    CallbackQuery,
)

from VIPMUSIC import app
from VIPMUSIC.misc import SUDOERS
from VIPMUSIC.utils.database import get_active_chats, get_active_video_chats
from config import BANNED_USERS, START_IMG_URL


# ---------------------- MAIN COMMAND ---------------------- #
@app.on_message(
    filters.command(["vcstats", "vcs", "vct"], prefixes=["/", "!", "%", ",", ".", "@", "#"])
    & ~BANNED_USERS
)
async def vcstats_handler(client, message: Message):

    # SUDOERS ONLY
    if message.from_user.id not in SUDOERS:
        return await message.reply_text("❌ Only SUDO users can use this command.")

    # FETCH STATS
    audio = len(await get_active_chats())
    video = len(await get_active_video_chats())

    caption = (
        "𝗕𝗼𝘁 𝗔𝗰𝘁𝗶𝘃𝗲 𝗖𝗵𝗮𝘁𝘀 𝗜𝗻𝗳𝗼 • 🔊\n"
        "•━━━━━━━━━━━━━━━━━━•\n"
        f"🎧 ᴀᴜᴅɪᴏ 🎧 » {audio} Active\n"
        "•───────•\n"
        f"🎥 ᴠɪᴅᴇᴏ 🎥 » {video} Active\n"
        "•──────•"
    )

    keyboard = InlineKeyboardMarkup(
        [
            [InlineKeyboardButton("🔁 Refresh", callback_data="vc_refresh")],
            [InlineKeyboardButton("❌ Close", callback_data="vc_close")],
        ]
    )

    await message.reply_photo(
        photo=START_IMG_URL,
        caption=caption,
        reply_markup=keyboard
    )


# ---------------------- AUTO REFRESH CALLBACK ---------------------- #
@app.on_callback_query(filters.regex("^vc_refresh$"))
async def vcstats_refresh(client, callback_query: CallbackQuery):

    # SUDOERS ONLY
    if callback_query.from_user.id not in SUDOERS:
        return await callback_query.answer("Unauthorized ❌", show_alert=True)

    # FETCH UPDATED STATS
    audio = len(await get_active_chats())
    video = len(await get_active_video_chats())

    caption = (
        "𝗕𝗼𝘁 𝗔𝗰𝘁𝗶𝘃𝗲 𝗖𝗵𝗮𝘁𝘀 𝗜𝗻𝗳𝗼 • 🔊 (Refreshed)\n"
        "•━━━━━━━━━━━━━━━━━━•\n"
        f"🎧 ᴀᴜᴅɪᴏ 🎧 » {audio} Active\n"
        "•───────•\n"
        f"🎥 ᴠɪᴅ𝗲𝗼 🎥 » {video} Active\n"
        "•──────•"
    )

    keyboard = InlineKeyboardMarkup(
        [
            [InlineKeyboardButton("🔁 Refresh Again", callback_data="vc_refresh")],
            [InlineKeyboardButton("❌ Close", callback_data="vc_close")],
        ]
    )

    # EDIT PHOTO CAPTION (NOT RESEND)
    await callback_query.message.edit_caption(
        caption=caption,
        reply_markup=keyboard
    )

    await callback_query.answer("🔁 Updated")


# ---------------------- CLOSE BUTTON ---------------------- #
@app.on_callback_query(filters.regex("^vc_close$"))
async def vcstats_close(client, callback_query: CallbackQuery):

    if callback_query.from_user.id not in SUDOERS:
        return await callback_query.answer("Unauthorized ❌", show_alert=True)

    try:
        await callback_query.message.delete()
    except:
        pass

    await callback_query.answer("Closed ❌")
